# Free keys only — no paid APIs.
# Groq: https://console.groq.com  (no credit card)
GROQ_API_KEY=

# Gemini: https://aistudio.google.com/apikey  (free Flash / Flash-Lite)
GEMINI_API_KEY=

# Mem0 Cloud: https://app.mem0.ai (optional; local memory is used if empty)
MEM0_API_KEY=

# Spotify app (Developer Dashboard). Redirect must be http://127.0.0.1:8000/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback

# Optional, still free: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Default city if the browser does not send coordinates
DEFAULT_CITY=Ahmedabad
DEFAULT_LAT=23.0225
DEFAULT_LON=72.5714

# --- Optional overrides (defaults shown; uncomment to change) ---

# LLM model names
GROQ_FAST_MODEL=
GROQ_REASON_MODEL=
GEMINI_PLAN_MODEL=
GEMINI_FALLBACK_MODELS=

# OSM-family endpoints and tuning
OVERPASS_URL=
OVERPASS_MIRRORS=
OVERPASS_TIMEOUT_S=
OVERPASS_BUDGET_S=
OVERPASS_TRIP_AFTER=
OVERPASS_COOLDOWN_S=
NOMINATIM_URL=
OSRM_URL=
OSM_MIN_INTERVAL_MS=

# Local storage paths
SQLITE_PATH=
CACHE_PATH=
